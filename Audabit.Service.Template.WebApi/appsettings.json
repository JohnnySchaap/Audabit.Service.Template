{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceSettings": {
    "ServiceName": "Template.WebApi"
  },
  "ApiKeySettings": {
    "Key": "ThisIsASampleApiWithRandomCharacters",
    "HeaderName": "X-API-KEY"
  },
  "HealthChecksSettings": {
    "CpuMonitoringEnabled": true,
    "CpuUpperThreshold": 80,
    "CpuMaxSamples": 10,
    "CpuSampleIntervalInSeconds": 5
  },
  "WeatherSettings": {
    "MinTemperature": -20,
    "MaxTemperature": 55,
    "ForecastDays": 5
  },
  "HttpClientSettings": {
    "DefaultSettings": {
      "Timeout": {
        "TimeoutSeconds": 5
      },
      "Retry": {
        "MaxRetryAttempts": 2,
        "RetryDelayMilliseconds": 200,
        "RetryBackoffPower": 2
      },
      "CircuitBreaker": {
        "FailureThreshold": 0.5,
        "MinimumThroughput": 10,
        "SampleDurationMilliseconds": 10000,
        "DurationOfBreakMilliseconds": 5000
      },
      "HttpRetryStatusCodes": [ 500, 502, 503, 504, 408, 429 ],
      "Logging": {
        "LogRequest": true,
        "LogRequestHeaders": true,
        "LogRequestBody": true,
        "LogResponse": true,
        "LogResponseHeaders": true,
        "LogResponseBody": true
      }
    },
    "Clients": {
      "StarWarsClient": {
        "BaseUrl": "https://swapi.info/api/",
        "Timeout": {
          "TimeoutSeconds": 5
        },
        "Retry": {
          "MaxRetryAttempts": 2,
          "RetryDelayMilliseconds": 200,
          "RetryBackoffPower": 2
        },
        "CircuitBreaker": {
          "FailureThreshold": 0.5,
          "MinimumThroughput": 10,
          "SampleDurationMilliseconds": 10000,
          "DurationOfBreakMilliseconds": 5000
        },
        "HttpRetryStatusCodes": [ 500, 502, 503, 504, 408, 429 ],
        "Logging": {
          "LogRequest": true,
          "LogRequestHeaders": true,
          "LogRequestBody": true,
          "LogResponse": true,
          "LogResponseHeaders": true,
          "LogResponseBody": true
        }
      },
      "StarWarsClientV2": {
        "BaseUrl": "https://swapi.info/api/",
        "Timeout": {
          "TimeoutSeconds": 5
        },
        "Retry": {
          "MaxRetryAttempts": 2,
          "RetryDelayMilliseconds": 200,
          "RetryBackoffPower": 2
        },
        "CircuitBreaker": {
          "FailureThreshold": 0.5,
          "MinimumThroughput": 10,
          "SampleDurationMilliseconds": 10000,
          "DurationOfBreakMilliseconds": 5000
        },
        "HttpRetryStatusCodes": [ 500, 502, 503, 504, 408, 429 ],
        "Logging": {
          "LogRequest": true,
          "LogRequestHeaders": true,
          "LogRequestBody": true,
          "LogResponse": true,
          "LogResponseHeaders": true,
          "LogResponseBody": true
        }
      }
    }
  }
}